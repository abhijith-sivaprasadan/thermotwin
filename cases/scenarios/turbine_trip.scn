# True generator-trip exercise: electrical output and fuel are isolated.
# The remaining BESS/renewables may be insufficient, so frequency need not
# recover to 50 Hz and UFLS can persist. This is a simple-grid teaching model.
name     turbine_trip
duration 60
dt       0.25

at 2.0  assert_near frequency_Hz 50.0 0.20
at 5.0  command turbine_trip
at 5.25 assert_near gt_trip_latched 1.0 0.01
at 5.25 assert_near gt_breaker_closed 0.0 0.01
at 5.25 assert_near gt_fuel_valve_open 0.0 0.01
at 5.25 assert_near gas_power_MW 0.0 0.001
at 5.25 assert_near fuel_flow_kg_s 0.0 0.001
at 5.25 assert_near gt_first_out 1.0 0.01
at 6.0  assert_below frequency_Hz 49.95
at 8.0  assert_below frequency_Hz 49.50
at 35.0 assert_below frequency_Hz 49.50
at 50.0 assert_below imbalance_MW -5.0
at 55.0 assert_above UFLS_stage 0.5
at 55.0 assert_near gas_power_MW 0.0 0.001
