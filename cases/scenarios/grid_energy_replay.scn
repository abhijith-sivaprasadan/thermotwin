# Deterministic mixed grid step for independent Python replay of the
# per-tick MW and MWh ledger. NOT a field or calibrated plant validation.
name grid_energy_replay
duration 12
dt       0.25

at 0.0   set auto_balance 0
at 0.0   set fcr_hold 1
at 0.0   set demand_MW 35
at 0.0   set renewable_MW 12
at 0.0   set storage_request_MW 0
at 0.25  assert_above gas_power_MW 10.0

at 2.0   set demand_MW 50
at 4.0   set storage_request_MW 15
at 7.0   set demand_MW 10
at 9.0   set storage_request_MW -12
at 11.75 assert_above battery_energy_MWh 0.1
