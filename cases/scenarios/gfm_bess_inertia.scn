# GFM BESS during a real GT-generator outage, NOT a mere 20% gas dispatch.
# Testing a single disturbance does not establish improved nadir or inertial
# response versus GFM-off: a paired scenario comparison is future work.
name     gfm_bess_inertia
duration 60
dt       0.25

at 0.0  set auto_balance 1
at 0.0  set gfm_mode 1
at 0.0  set gfm_virtual_H 4.0
at 0.0  set battery_soc_pct 60
at 0.0  set demand_MW 35
at 0.0  set renewable_MW 8

at 3.0  assert_near frequency_Hz 50.0 0.20
at 3.0  assert_above gfm_H_equiv 0.5
at 5.0  command turbine_trip
at 5.25 assert_near gt_breaker_closed 0.0 0.01
at 5.25 assert_near gas_power_MW 0.0 0.001
at 5.25 assert_above frequency_Hz 49.0
at 6.0  assert_above frequency_Hz 49.2
at 6.0  assert_above gfm_synth_MW 0.01
at 35.0 assert_below frequency_Hz 49.5
# Shed load reduces served demand; report net balance against served load.
at 50.0 assert_above ufls_shed_MW 1.0
at 50.0 assert_below served_demand_MW 34.0
at 50.0 assert_near imbalance_MW 0.0 1.0
at 55.0 assert_above UFLS_stage 0.5

at 56.0 set gfm_mode 0
at 58.0 assert_below gfm_H_equiv 0.1
