# P2X electrolyser: high-renewable surplus period drives the electrolyser.
# When RES >> demand, the electrolyser absorbs excess power, preventing
# curtailment and producing hydrogen. Tests load absorption and H2 output.
name     p2x_electrolyser
duration 45
dt       0.25

at 0.0   set auto_balance 1
at 0.0   set renewable_MW 40
at 0.0   set demand_MW 35
at 0.0   set gas_dispatch_pct 25
at 0.0   set p2x_active 1

at 5.0   assert_near  frequency_Hz 50.0 0.30         # stable despite large RES
at 5.0   assert_above p2x_load_MW 0.1               # electrolyser absorbing surplus
at 5.0   assert_above p2x_h2_kg_s 0.001             # hydrogen flowing

# Further increase RES to stress the surplus path
at 10.0  set renewable_MW 55

at 15.0  assert_above p2x_load_MW 10.0              # electrolyser loading up heavily
at 15.0  assert_below frequency_Hz 50.5             # BESS + P2X preventing over-freq
at 15.0  assert_above frequency_Hz 49.5

# Disable P2X; AGC must now curtail instead
at 25.0  set p2x_active 0

at 30.0  assert_above renewable_curtail_MW 5.0       # curtailment fills the gap
at 35.0  assert_near  frequency_Hz 50.0 0.40
