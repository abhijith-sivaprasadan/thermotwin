# Combined-cycle equation/model regression (NOT measured or OEM validation). Checks HRSG
# thermal performance, steam ramp, combined efficiency, and pinch margin.
name     combined_cycle
duration 30
dt       0.25

at 0.0   set auto_balance 0
at 0.0   set combined_cycle 1
at 0.0   set gas_dispatch_pct 100
at 0.0   set demand_MW 52
at 0.0   set renewable_MW 0
at 0.0   set storage_request_MW 0

at 1.0   assert_above steam_power_MW 15.0
at 1.0   assert_above plant_power_MW 45.0
# The snapshot is the actual recalculated variable-property simulator output
# after deriving M_mix and R_mix from the same molar species fractions.
at 1.0   assert_near plant_efficiency 0.5057 0.001
at 1.0   assert_above hrsg_pinch_K 14.9
at 1.0   assert_above hrsg_stack_T_K 360.0

# Verify HRSG reaches thermal steady-state (steam not still ramping)
at 15.0  assert_above steam_power_MW 15.0
at 15.0  assert_below hrsg_stack_T_K 430.0          # not wasting exhaust heat

# Part-load combined cycle: GT backs down, steam follows
at 20.0  set gas_dispatch_pct 65
at 28.0  assert_near plant_efficiency 0.4797 0.001 # solver-derived part-load regression only
at 28.0  assert_above steam_power_MW 10.0            # steam following down
at 28.0  assert_above hrsg_pinch_K 10.0             # pinch not violated at part load
